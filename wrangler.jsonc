{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myturn-cron-trigger",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "workers_dev": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "TICK_URL": "https://myturn.emirozdis.tr/api/cron/tick"
  },
  "secrets": {
    "required": ["CRON_SECRET"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

